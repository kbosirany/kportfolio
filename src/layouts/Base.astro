---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import { profil } from '../lib/donnees';
import {
  langues, chemin, sansLangue, traduire, type Langue,
} from '../lib/i18n';

interface Props { titre?: string; lang?: Langue }
const { titre, lang = 'fr' } = Astro.props;
const t = (cle: string, v?: Record<string, string | number>) =>
  traduire(lang, cle, v);
const page = sansLangue(Astro.url.pathname);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre ? `${titre} · ${profil.nom}` : profil.nom}</title>
    <meta name="description"
          content={t('meta.description', { nom: profil.nom })} />
    {langues.map((l) => (
      <link rel="alternate" hreflang={l}
            href={new URL(chemin(l, page), Astro.site)} />
    ))}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`}
          type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=JetBrains+Mono:wght@400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Navigation lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-ligne bg-fond-doux py-10 text-center
                   text-sm text-doux">
      <p class="font-titre italic text-3xl text-accent">{profil.nom}</p>
      <p class="mt-6 font-code text-xs text-doux/70">
        &lt;/&gt; {t('pied.code')}
      </p>
    </footer>
  </body>
</html>
