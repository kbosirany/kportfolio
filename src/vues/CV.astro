---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import { cvYml } from '../lib/donnees';
import { loc, traduire, type Langue } from '../lib/i18n';

interface Props { lang: Langue }
const { lang } = Astro.props;
const t = (cle: string, v?: Record<string, string | number>) =>
  traduire(lang, cle, v);
const base = import.meta.env.BASE_URL;
const cvs = cvYml.cv.map((cv) => ({
  ...cv,
  present: existsSync(`public/${cv.fichier}`),
}));
---
<Base lang={lang} titre={t('cv.titre')}>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="titre-section">{t('cv.titre')}</h1>
    <ul class="mt-8 grid gap-5">
      {cvs.map((cv) => (
        <li class="carte flex flex-wrap items-center justify-between gap-4">
          <div>
            <h2 class="text-2xl">{loc(cv, 'titre', lang)}</h2>
            <p class="etiquette mt-1">
              {cv.langue}{cv.maj && ` · ${t('cv.maj', { date: cv.maj })}`}
            </p>
          </div>
          {cv.present ? (
            <a class="bouton" href={`${base}${cv.fichier}`}>
              {t('cv.telecharger')} ↓
            </a>
          ) : (
            <span class="puce">{t('cv.bientot')}</span>
          )}
        </li>
      ))}
    </ul>
    <p class="mt-6 text-sm text-doux">
      <a class="text-accent hover:underline" href={cvYml.source}>
        {t('cv.source')} ↗
      </a>
    </p>
  </div>
</Base>
