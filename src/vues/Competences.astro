---
import Base from '../layouts/Base.astro';
import { competences } from '../lib/donnees';
import { loc, traduire, type Langue } from '../lib/i18n';

interface Props { lang: Langue }
const { lang } = Astro.props;
const t = (cle: string) => traduire(lang, cle);
---
<Base lang={lang} titre={t('competences.titre')}>
  <div class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="titre-section">{t('competences.titre')}</h1>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {competences.map((c) => (
        <section class="carte">
          <h2 class="text-2xl text-accent">{loc(c, 'nom', lang)}</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {c.items.map((i) => <li class="puce">{i}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>
